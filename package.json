    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.21",
    "typescript": "~5.7.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
